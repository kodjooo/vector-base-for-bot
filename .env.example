# Ключ OpenAI API
# Получить на https://platform.openai.com/api-keys
OPENAI_API_KEY=changeme-openai-key

# Модель для генерации эмбеддингов
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Количество релевантных чанков, возвращаемых при поиске
SEARCH_TOP_K=3

# Путь к файлу сервисного аккаунта Google (монтируется в контейнер)
# Как получить: https://console.cloud.google.com → IAM → Сервисные аккаунты → Ключи
GOOGLE_SERVICE_ACCOUNT_FILE=/secrets/google_service_account.json

# ID документов Google Docs через запятую
# Найти в URL документа: docs.google.com/document/d/<ID>/edit
GOOGLE_DOC_IDS=doc-id-1,doc-id-2

GOOGLE_REQUEST_INTERVAL_SECONDS=0.25
GOOGLE_MAX_RETRIES=5
GOOGLE_RETRY_INITIAL_DELAY=1.0

# Хост ChromaDB внутри Docker-сети (имя сервиса из docker-compose)
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=knowledge

EMBEDDING_CHUNK_SIZE=800
EMBEDDING_CHUNK_OVERLAP=100

# Интервал плановой синхронизации документов (минуты)
SYNC_INTERVAL_MINUTES=15

# Порт HTTP API поиска (доступен support-bot по этому порту)
API_PORT=8080

LOG_LEVEL=INFO
